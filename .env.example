# OpenRouter API Key (get free at https://openrouter.ai)
OPENROUTER_API_KEY=your_key_here

# PostgreSQL (optional - falls back to SQLite if not provided)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=proptech_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password

# Redis (optional - falls back to in-memory if not provided)
REDIS_URL=redis://localhost:6379

# App Config
PORT=8000
API_SECRET=change_this_secret
